  "version": "0.1.0",
  "author": {
    "name": "Sergio Valverde",
    "url": "https://github.com/svg153"
  },
  "homepage": "https://github.com/svg153/software-factory",
  "repository": "https://github.com/svg153/software-factory",
  "license": "MIT",
  "keywords": [
    "agent-plugins",
    "agent-skills",
    "autonomous-iteration",
    "canvas",
    "github-copilot",
    "github-issues",
    "github-projects",
    "pipeline",
    "software-factory",
    "workflow-automation"
  ],
  "extensions": {
    "com.github.copilot": {
      "logo": "assets/preview.png"
    },
    "com.github.awesome-copilot": {
      "extensions": [
        "./extensions/software-factory"
      ],
      "skills": [
        "./skills/software-factory/"
      ]
    }
  }
}
